# - - - - - TELEGRAM BOT SETTINGS - - - - - #

# Localization languages. Avoid spaces between entries. The order determines language priority.
# For the full list of locales, refer to aiogram_bot_template/enums/locale.py
TELEGRAM_LOCALES=en

# Telegram bot token, obtainable via https://t.me/BotFather
TELEGRAM_BOT_TOKEN=42:ABC

# Drop old updates when the bot was inactive (True/False)
TELEGRAM_DROP_PENDING_UPDATES=False

# Webhook configuration
TELEGRAM_USE_WEBHOOK=False
TELEGRAM_RESET_WEBHOOK=True
TELEGRAM_WEBHOOK_PATH=/telegram
TELEGRAM_WEBHOOK_SECRET=123456abcdef

# - - - - - POSTGRESQL SETTINGS - - - - - #

# Host (default is the Docker container name)
POSTGRES_HOST=postgres

# Database password
POSTGRES_PASSWORD=my_pg_password

# Database name
POSTGRES_DB=my_db_name

# Port (default: 5432)
POSTGRES_PORT=5432

# Username
POSTGRES_USER=my_pg_user

# Path to PostgreSQL data for Docker volumes
POSTGRES_DATA=/var/lib/postgresql/data

# - - - - - SQLALCHEMY SETTINGS - - - - - #
ALCHEMY_ECHO=False
ALCHEMY_ECHO_POOL=False
ALCHEMY_POOL_SIZE=25
ALCHEMY_MAX_OVERFLOW=50
ALCHEMY_POOL_TIMEOUT=10
ALCHEMY_POOL_RECYCLE=3600

# - - - - - REDIS SETTINGS - - - - - #

# Host (default is the Docker container name)
REDIS_HOST=redis

# Port (default: 6379)
REDIS_PORT=6379

# Database (0 if using only a single database)
REDIS_DB=0

# Redis password
REDIS_PASSWORD=12345abcdef

# Path to Redis data for Docker volumes
REDIS_DATA=/redis_data

# - - - - - SERVER SETTINGS - - - - - #
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_URL=https://my.server.com

# - - - - - OTHER SETTINGS - - - - - #

# Bot admin chat id (for a private chat it equals the admin's Telegram user ID).
# Admin commands (/stats, /ban, /premium, /broadcast, ...) only work in this chat.
COMMON_ADMIN_CHAT_ID=123456789

# Optional Sentry DSN
# COMMON_SENTRY_DSN=

# - - - - - LLM SETTINGS - - - - - #

# deepseek / openai / anthropic / gemini
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...
# Main tutor model and a cheaper one for conversation summaries
# Optional, for other OpenAI-compatible APIs
# LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_SUMMARY_MODEL=deepseek-chat
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=2
# Maximum LLM response length
LLM_MAX_OUTPUT_TOKENS=600
LLM_TEMPERATURE=0.7
# Limited-context strategy: last N messages + rolling summary
LLM_CONTEXT_MESSAGES=12
LLM_SUMMARIZE_AFTER_MESSAGES=20
LLM_RECENT_MISTAKES_IN_PROMPT=5
# USD per 1M tokens (approximate cost tracking in admin stats)
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0

# - - - - - SPEECH SETTINGS - - - - - #

# openai
SPEECH_PROVIDER=openai
SPEECH_API_KEY=sk-...
SPEECH_STT_MODEL=
SPEECH_REQUEST_TIMEOUT=60
SPEECH_STT_PRICE_PER_MINUTE=0
# Optional audio replies
SPEECH_TTS_ENABLED=False
SPEECH_TTS_MODEL=
SPEECH_TTS_VOICE=

# - - - - - LIMITS - - - - - #

# Daily quotas, 0 = unlimited
LIMITS_FREE_DAILY_MESSAGES=20
LIMITS_FREE_DAILY_VOICE_MESSAGES=3
LIMITS_PREMIUM_DAILY_MESSAGES=0
LIMITS_PREMIUM_DAILY_VOICE_MESSAGES=0
# Seconds
LIMITS_MAX_VOICE_DURATION=60
# Characters
LIMITS_MAX_INPUT_LENGTH=1000
# Minimal interval between requests of one user, seconds
LIMITS_THROTTLE_RATE=1.0
# Duplicate Telegram update protection window, seconds
LIMITS_UPDATE_DEDUP_TTL=300
